<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.book.mapper.BookMapper">
	<select id="bookList" resultType="com.book.entity.BookVO">
		select * from tbl_book 
	</select>
	
	<insert id="bookInsert" parameterType="com.book.entity.BookVO">  <!-- ID 수정 -->
    insert into tbl_book(title, author, company, isbn, count) 
    			values (#{title}, #{author}, #{company}, #{isbn}, #{count})
	</insert>


</mapper>