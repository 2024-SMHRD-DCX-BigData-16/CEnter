<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.center.mapper.PostMapper">
   
   <select id="findPostsByCategory" resultType="com.center.entity.Post">
      select * from post where category = #{category}
   </select>
   
   
   <!-- 게시글 추가  -->
   <insert id="postInsert" parameterType="com.center.entity.Post">
    	INSERT INTO post (post_title, post_file, post_content, mb_id)
      	VALUES (#{post_title}, #{post_file}, #{post_content}, #{mb_id})
   </insert>
   
   <!-- 모든 게시글 조회  -->
   <select id="postselect" resultType="com.center.entity.Post">
   		select * from post
   </select>
   
   <!--특정 게시글 상세 조회 -->
   <select id="postcontent" parameterType="int" resultType="com.center.entity.Post">
      select * from post where post_idx = #{post_idx}
   </select>
   
</mapper>